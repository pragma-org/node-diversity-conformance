{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://node-diversity-conformance.pragma.io/scenarios/cbor-decoding/schema.json",
  "title": "CBOR decoding conformance report",
  "type": "object",
  "required": ["schema_version", "scenario", "generated_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "scenario": { "const": "cbor-decoding" },
    "generated_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "implementation": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "language": { "type": "string" }
      },
      "additionalProperties": false
    },
    "error": { "type": "string", "minLength": 1 },
    "corpus": { "type": "string" },
    "protocol_version": { "type": ["string", "number"] },
    "totals": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "rules": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/outcome" }
    },
    "failures": { "type": "array", "items": { "type": "object" } }
  },
  "oneOf": [
    {
      "required": ["implementation", "error"],
      "not": {
        "anyOf": [
          { "required": ["corpus"] },
          { "required": ["protocol_version"] },
          { "required": ["totals"] },
          { "required": ["rules"] },
          { "required": ["failures"] }
        ]
      }
    },
    {
      "required": ["corpus", "protocol_version", "totals", "rules"],
      "not": { "required": ["error"] }
    }
  ],
  "$defs": {
    "outcome": {
      "type": "object",
      "additionalProperties": { "type": ["integer", "number", "string", "boolean", "null"] }
    }
  }
}
