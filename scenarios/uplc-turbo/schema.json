{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://node-diversity-conformance.pragma.io/scenarios/uplc-turbo/schema.json",
  "title": "UPLC turbo benchmark scenario report",
  "type": "object",
  "required": ["schema_version", "scenario", "generated_at", "implementation", "benchmarks"],
  "properties": {
    "schema_version": { "const": "1" },
    "scenario": { "const": "uplc-turbo" },
    "generated_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "implementation": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "language": { "type": "string" }
      },
      "additionalProperties": false
    },
    "machine": {
      "$ref": "#/$defs/machine"
    },
    "benchmarks": {
      "type": "array",
      "items": { "$ref": "#/$defs/benchmark" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "machine": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "os_version": { "type": ["string", "null"] },
        "architecture": { "type": "string" },
        "cpu": { "type": ["string", "null"] },
        "logical_cores": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "benchmark": {
      "type": "object",
      "required": ["bench", "plutus_version", "protocol_version", "budget_cpu", "budget_mem", "cpu_us", "flat_us", "mem_bytes", "size_bytes"],
      "properties": {
        "bench": { "type": "string" },
        "plutus_version": { "type": "string", "enum": ["V1", "V2", "V3"] },
        "protocol_version": { "type": ["string", "number"] },
        "budget_cpu": { "type": ["integer", "null"], "minimum": 0 },
        "budget_mem": { "type": ["integer", "null"], "minimum": 0 },
        "cpu_us": {
          "type": "number",
          "minimum": 0,
          "description": "Mean pure CEK evaluation time in microseconds."
        },
        "flat_us": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Mean flat decoding time in microseconds, or null when decoding was not measured."
        },
        "mem_bytes": { "type": ["number", "null"], "minimum": 0 },
        "size_bytes": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
