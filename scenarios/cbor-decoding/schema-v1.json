{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://node-diversity-conformance.pragma.io/scenarios/cbor-decoding/schema-v1.json",
  "title": "CBOR decoding conformance report, version 1",
  "type": "object",
  "required": [
    "version",
    "scenario",
    "generated_at",
    "corpus",
    "protocol_version",
    "totals",
    "rules"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "scenario": {
      "const": "cbor-decoding"
    },
    "generated_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "corpus": {
      "type": "string"
    },
    "protocol_version": {
      "type": [
        "string",
        "number"
      ]
    },
    "totals": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/outcome"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "outcome": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    }
  }
}
