{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://node-diversity-conformance.pragma.io/scenarios/uplc-conformance/schema.json",
  "title": "UPLC conformance scenario report",
  "type": "object",
  "required": ["schema_version", "scenario", "generated_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "scenario": { "const": "uplc-conformance" },
    "generated_at": { "type": "string", "format": "date-time" },
    "implementation": { "type": "object" },
    "error": { "type": "string", "minLength": 1 },
    "protocol_version": { "type": ["string", "number"] },
    "cost_models": {
      "type": "array",
      "items": { "$ref": "#/$defs/cost_model" }
    },
    "totals": {
      "type": "object",
      "required": ["total", "passed", "failed", "evaluation", "budget"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "evaluation": { "$ref": "#/$defs/dimension_totals" },
        "budget": { "$ref": "#/$defs/dimension_totals" }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "group", "evaluation", "budget", "cost_model_id", "passed"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "group": { "type": "string" },
          "plutus_version": { "type": ["string", "integer"] },
          "protocol_version": { "type": ["string", "integer"] },
          "cost_model_id": { "type": "string" },
          "evaluation": { "$ref": "#/$defs/outcome" },
          "budget": { "$ref": "#/$defs/outcome" },
          "passed": { "type": "boolean" },
          "error": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "oneOf": [
    {
      "required": ["implementation", "error"],
      "not": {
        "anyOf": [
          { "required": ["protocol_version"] },
          { "required": ["cost_models"] },
          { "required": ["totals"] },
          { "required": ["scenarios"] }
        ]
      }
    },
    {
      "required": ["protocol_version", "cost_models", "totals", "scenarios"],
      "not": { "required": ["error"] }
    }
  ],
  "$defs": {
    "dimension_totals": {
      "type": "object",
      "required": ["passed", "failed", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["expected", "actual", "passed"],
      "properties": {
        "expected": {},
        "actual": {},
        "passed": { "type": ["boolean", "null"] }
      },
      "additionalProperties": false
    },
    "cost_model": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "plutus_version": { "type": ["string", "integer"] },
        "protocol_version": { "type": ["string", "integer"] },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
