{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://node-diversity-conformance.pragma.io/scenarios/uplc-conformance/schema.json",
  "title": "UPLC functional tests scenario report",
  "type": "object",
  "required": ["version", "scenario", "generated_at", "implementation", "scenarios"],
  "properties": {
    "version": { "const": "1" },
    "scenario": { "const": "uplc-conformance" },
    "generated_at": { "type": "string", "format": "date-time" },
    "implementation": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" } },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "group", "plutus_version", "protocol_version", "evaluation", "budget"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "group": { "type": "string" },
          "plutus_version": { "type": ["string", "integer", "null"] },
          "protocol_version": { "type": ["string", "integer", "null"] },
          "evaluation": { "type": "string" },
          "budget": {
            "type": ["object", "null"],
            "required": ["cpu", "mem"],
            "properties": {
              "cpu": { "type": "integer" },
              "mem": { "type": "integer" }
            },
            "additionalProperties": false
          },
          "error": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
