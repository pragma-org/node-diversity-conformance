{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://node-diversity-conformance.pragma.io/scenarios/ledger-rules/schema.json",
  "title": "Ledger transaction-rule scenario report",
  "type": "object",
  "required": ["version", "scenario", "generated_at", "implementation", "scenarios"],
  "properties": {
    "version": { "const": "1" },
    "scenario": { "const": "ledger-rules" },
    "generated_at": { "type": "string", "format": "date-time" },
    "implementation": {
      "type": "object",
      "required": [ "name" ],
      "properties": {
        "name": { "type": "string" }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "additionalProperties": false,
          "id": { "type": "string", "pattern": "^[0-9]{5}$" },
          "result": {
            "oneOf": [
              { "const": "pass" },
              { "const": "BabbageNonDisjointRefInputs" },
              { "const": "BabbageOutputTooSmallUTxO" },
              { "const": "BadInputsUTxO" },
              { "const": "CommitteeHasPreviouslyResigned" },
              { "const": "CommitteeIsUnknown" },
              { "const": "ConflictingMetadataHash" },
              { "const": "ConwayTreasuryValueMismatch" },
              { "const": "ConwayTxRefScriptsSizeTooBig" },
              { "const": "ConwayWdrlNotDelegatedToDRep" },
              { "const": "DRepAlreadyRegistered" },
              { "const": "DRepNotRegistered" },
              { "const": "DecodingFailure" },
              { "const": "DelegateeDRepNotRegistered" },
              { "const": "DelegateeStakePoolNotRegistered" },
              { "const": "DisallowedVoters" },
              { "const": "ExtraneousScriptWitnessesUTXOW" },
              { "const": "FeeTooSmallUTxO" },
              { "const": "GovActionsDoNotExist" },
              { "const": "IncorrectDepositDELEG" },
              { "const": "IncorrectDepositDRep" },
              { "const": "IncorrectTotalCollateralField" },
              { "const": "InputSetEmptyUTxO" },
              { "const": "InsufficientCollateral" },
              { "const": "InvalidGuardrailsScriptHash" },
              { "const": "InvalidPrevGovActionId" },
              { "const": "InvalidWitnessesUTXOW" },
              { "const": "MalformedReferenceScripts" },
              { "const": "MalformedScriptWitnesses" },
              { "const": "MaxTxSizeUTxO" },
              { "const": "MissingScriptWitnessesUTXOW" },
              { "const": "MissingTxBodyMetadataHash" },
              { "const": "MissingTxMetadata" },
              { "const": "MissingVerificationKeyWitnessesUTXOW" },
              { "const": "NoCollateralInputs" },
              { "const": "OutputTooBigUTxO" },
              { "const": "OutsideForecast" },
              { "const": "OutsideValidityIntervalUTxO" },
              { "const": "ProposalCantFollow" },
              { "const": "ProposalProcedureNetworkIdMismatch" },
              { "const": "ProposalReturnAccountDoesNotExist" },
              { "const": "ScriptsNotPaidUTxO" },
              { "const": "StakeCredentialInvalidPoolDelegation" },
              { "const": "StakeCredentialInvalidVoteDelegation" },
              { "const": "StakeKeyHasNonZeroAccountBalance" },
              { "const": "StakeKeyNotRegistered" },
              { "const": "StakeKeyRegistered" },
              { "const": "StakePoolCostTooLowPOOL" },
              { "const": "StakePoolNotRegisteredOnKeyPOOL" },
              { "const": "StakePoolRetirementWrongEpochPOOL" },
              { "const": "TooManyCollateralInputs" },
              { "const": "TreasuryWithdrawalReturnAccountsDoNotExist" },
              { "const": "TreasuryWithdrawalsAllZeros" },
              { "const": "ValidationTagMismatch" },
              { "const": "ValueNotConservedUTxO" },
              { "const": "VotersDoNotExist" },
              { "const": "VotingOnExpiredGovAction" },
              { "const": "WithdrawalsNotInRewardsCERTS" },
              { "const": "WrongNetworkInTxBody" },
              { "const": "WrongNetworkInTxOutput" },
              { "const": "WrongNetworkPOOL" },
              { "const": "WrongNetworkWithdrawal" }
            ]
          }
        }
      }
    }
  }
}
